{
  "name": "openkite-release",
  "private": true,
  "description": "Version producer for the openkite workspace: conventional commits in, a semver tag and a GitHub release out.",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomakori/openkite.git"
  },
  "scripts": {
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/release-notes-generator": "14.1.1",
    "semantic-release": "26.0.1"
  }
}
